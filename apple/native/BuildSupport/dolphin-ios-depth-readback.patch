+std::string GeneratePackedDepthPixelShader(u32 samples)
+{
+  ShaderCode code;
+  EmitSamplerDeclarations(code, 0, 1, samples > 1);
+  EmitPixelMainDeclaration(code, 1, 0);
+  code.Write("{{\n"
+             "  int3 coords = int3(int2(gl_FragCoord.xy), int(v_tex0.z));\n"
+             "  float depth = texelFetch(samp0, coords, 0).r;\n");
+  if (samples > 1)
+  {
+    code.Write("  for (int i = 1; i < {}; i++)\n", samples);
+    code.Write("    depth = min(depth, texelFetch(samp0, coords, i).r);\n");
+  }
+  code.Write("  uint bits = floatBitsToUint(depth);\n"
+             "  ocol0 = float4(float(bits & 255u), float((bits >> 8u) & 255u),\n"
+             "                 float((bits >> 16u) & 255u), float((bits >> 24u) & 255u)) / 255.0;\n"
+             "}}\n");
+  return code.GetBuffer();
+}
