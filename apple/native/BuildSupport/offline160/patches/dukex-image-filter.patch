+"// GLSL port of VETA Screen.metal.\n"
+"\n"
+"#define CORNER_C\n"
+"vec4 xbr_clamp01(vec4 x){return clamp(x,0.0,1.0);}\n"
+"vec4 xbr_tap(sampler2D frame,vec2 uv,vec2 range){\n"
+"\n"
+"uv.y=clamp(uv.y,range.x,range.y);ivec2 size=textureSize(frame,0);return texelFetch(frame,clamp(ivec2(floor(uv*vec2(size))),ivec2(0),size-1),0);\n"
+"}\n"
+"const vec4 Ao = vec4( 1.0, -1.0, -1.0, 1.0 );\n"
+"const vec4 Bo = vec4( 1.0,  1.0, -1.0,-1.0 );\n"
+"const vec4 Co = vec4( 1.5,  0.5, -0.5, 0.5 );\n"
+"const vec4 Ax = vec4( 1.0, -1.0, -1.0, 1.0 );\n"
+"const vec4 Bx = vec4( 0.5,  2.0, -0.5,-2.0 );\n"
+"const vec4 Cx = vec4( 1.0,  1.0, -0.5, 0.0 );\n"
+"const vec4 Ay = vec4( 1.0, -1.0, -1.0, 1.0 );\n"
+"const vec4 By = vec4( 2.0,  0.5, -2.0,-0.5 );\n"
+"const vec4 Cy = vec4( 2.0,  0.0, -1.0, 0.5 );\n"
+"const vec4 Ci = vec4(0.25, 0.25, 0.25, 0.25);\n"
+"\n"
+"const vec3 v2f = vec3( 65536, 256, 1); // vec to float encode\n"
+"const vec3 Y = vec3(0.2627, 0.6780, 0.0593);\n"
+"\n"
+"// Return if A components are less than or equal B ones.\n"
+"vec4 xbr_LTE(vec4 A, vec4 B)\n"
+"{\n"
+"    return step(A, B);\n"
+"}\n"
+"\n"
+"// Return if A components are less than B ones.\n"
+"vec4 xbr_LT(vec4 A, vec4 B)\n"
+"{\n"
+"    return vec4(lessThan(A,B));\n"
+"}\n"
+"\n"
+"// Return logically inverted vector components. BEWARE: Only works with 0.0 or 1.0 components.\n"
+"vec4 xbr_NOT(vec4 A)\n"
+"{\n"
+"    return (vec4(1.0) - A);\n"
+"}\n"
+"\n"
+"// Compare two vectors and return their components are different.\n"
+"vec4 xbr_diff(vec4 A, vec4 B)\n"
+"{\n"
+"    return vec4(notEqual(A,B));\n"
+"}\n"
+"\n"
+"float xbr_dist(vec3 A, vec3 B)\n"
+"{\n"
+"    return dot(abs(A-B), Y);\n"
+"}\n"
+"\n"
+"// Calculate color distance between two vectors of four pixels\n"
+"vec4 xbr_dist4(mat4x3 A, mat4x3 B)\n"
+"{\n"
+"    return vec4(xbr_dist(A[0],B[0]), xbr_dist(A[1],B[1]), xbr_dist(A[2],B[2]), xbr_dist(A[3],B[3]));\n"
+"}\n"
+"\n"
+"// Tests if color components are under a threshold. In this case they are considered 'equal'.\n"
+"vec4 xbr_eq(mat4x3 A, mat4x3 B)\n"
+"{\n"
+"    return (step(xbr_dist4(A, B), vec4(0.32)));\n"
+"}\n"
+"\n"
+"// Determine if two vector components are xbr_NOT equal based on a threshold.\n"
+"vec4 xbr_neq(mat4x3 A, mat4x3 B)\n"
+"{\n"
+"    return (vec4(1.0, 1.0, 1.0, 1.0) - xbr_eq(A, B));\n"
+"}\n"
+"\n"
+"// Calculate weighted distance among pixels in some directions.\n"
+"vec4 xbr_weighted_distance(mat4x3 a, mat4x3 b, mat4x3 c, mat4x3 d, mat4x3 e, mat4x3 f, mat4x3 g, mat4x3 h)\n"
+"{\n"
+"    return (xbr_dist4(a,b) + xbr_dist4(a,c) + xbr_dist4(d,e) + xbr_dist4(d,f) + 4.0*xbr_dist4(g,h));\n"
+"}\n"
+"\n"
+"\n"
+"\n"
+"vec4 xbr_scale(sampler2D frame,vec2 texCoord,bool split) {\n"
+"vec2 size=vec2(textureSize(frame,0));\n"
+"float halfTexel=0.5/size.y;float low=split && texCoord.y>=0.5 ? 0.5:0.0;\n"
+"vec2 range=vec2(low+halfTexel,(split ? low+0.5:1.0)-halfTexel);\n"
+"float dx=1.0/size.x,dy=1.0/size.y;\n"
+"float aa_factor=max(0.001,2.0*length(dFdx(texCoord*size)));\n"
+"   vec4 t1 = texCoord.xxxy + vec4( -dx, 0, dx,-2.0*dy); // A1 B1 C1\n"
+"   vec4 t2 = texCoord.xxxy + vec4( -dx, 0, dx,    -dy); //  A  B  C\n"
+"   vec4 t3 = texCoord.xxxy + vec4( -dx, 0, dx,      0); //  D  E  F\n"
+"   vec4 t4 = texCoord.xxxy + vec4( -dx, 0, dx,     dy); //  G  H  I\n"
+"   vec4 t5 = texCoord.xxxy + vec4( -dx, 0, dx, 2.0*dy); // G5 H5 I5\n"
+"   vec4 t6 = texCoord.xyyy + vec4(-2.0*dx,-dy, 0,  dy); // A0 D0 G0\n"
+"   vec4 t7 = texCoord.xyyy + vec4( 2.0*dx,-dy, 0,  dy); // C4 F4 I4\n"
+"    vec4 edri, edr, edr_l, edr_u, px; // px = pixel, edr = edge detection rule\n"
+"    vec4 irlv0, irlv1, irlv2l, irlv2u;\n"
+"    vec4 fx, fx_l, fx_u; // inequations of straight lines.\n"
+"    vec3 res1, res2;\n"
+"    vec4 fx45i, fx45, fx30, fx60;\n"
+"\n"
+"    vec2 fp  = fract(texCoord*size);\n"
+"\n"
+"    vec3 A1 = xbr_tap(frame,t1.xw,range).xyz;\n"
+"    vec3 B1 = xbr_tap(frame,t1.yw,range).xyz;\n"
+"    vec3 C1 = xbr_tap(frame,t1.zw,range).xyz;\n"
+"    vec3 A  = xbr_tap(frame,t2.xw,range).xyz;\n"
+"    vec3 B  = xbr_tap(frame,t2.yw,range).xyz;\n"
+"    vec3 C  = xbr_tap(frame,t2.zw,range).xyz;\n"
+"    vec3 D  = xbr_tap(frame,t3.xw,range).xyz;\n"
+"    vec3 E  = xbr_tap(frame,t3.yw,range).xyz;\n"
+"    vec3 F  = xbr_tap(frame,t3.zw,range).xyz;\n"
+"    vec3 G  = xbr_tap(frame,t4.xw,range).xyz;\n"
+"    vec3 H  = xbr_tap(frame,t4.yw,range).xyz;\n"
+"    vec3 I  = xbr_tap(frame,t4.zw,range).xyz;\n"
+"    vec3 G5 = xbr_tap(frame,t5.xw,range).xyz;\n"
+"    vec3 H5 = xbr_tap(frame,t5.yw,range).xyz;\n"
+"    vec3 I5 = xbr_tap(frame,t5.zw,range).xyz;\n"
+"    vec3 A0 = xbr_tap(frame,t6.xy,range).xyz;\n"
+"    vec3 D0 = xbr_tap(frame,t6.xz,range).xyz;\n"
+"    vec3 G0 = xbr_tap(frame,t6.xw,range).xyz;\n"
+"    vec3 C4 = xbr_tap(frame,t7.xy,range).xyz;\n"
+"    vec3 F4 = xbr_tap(frame,t7.xz,range).xyz;\n"
+"    vec3 I4 = xbr_tap(frame,t7.xw,range).xyz;\n"
+"\n"
+"    mat4x3 b  = mat4x3(B, D, H, F);\n"
+"    mat4x3 c  = mat4x3(C, A, G, I);\n"
+"    mat4x3 d  = mat4x3(D, H, F, B);\n"
+"    mat4x3 e  = mat4x3(E, E, E, E);\n"
+"    mat4x3 f  = mat4x3(F, B, D, H);\n"
+"    mat4x3 g  = mat4x3(G, I, C, A);\n"
+"    mat4x3 h  = mat4x3(H, F, B, D);\n"
+"    mat4x3 i  = mat4x3(I, C, A, G);\n"
+"\n"
+"    mat4x3 i4 = mat4x3(I4, C1, A0, G5);\n"
+"    mat4x3 i5 = mat4x3(I5, C4, A1, G0);\n"
+"    mat4x3 h5 = mat4x3(H5, F4, B1, D0);\n"
+"    mat4x3 f4 = mat4x3(F4, B1, D0, H5);\n"
+"\n"
+"    vec4 b_   = vec4(dot(v2f,b[0]),dot(v2f,b[1]),dot(v2f,b[2]),dot(v2f,b[3]));\n"
+"    vec4 c_   = vec4(dot(v2f,c[0]),dot(v2f,c[1]),dot(v2f,c[2]),dot(v2f,c[3]));\n"
+"    vec4 d_   = b_.yzwx;\n"
+"    vec4 e_   = vec4(dot(v2f,e[0]),dot(v2f,e[1]),dot(v2f,e[2]),dot(v2f,e[3]));\n"
+"    vec4 f_   = b_.wxyz;\n"
+"    vec4 g_   = c_.zwxy;\n"
+"    vec4 h_   = b_.zwxy;\n"
+"    vec4 i_   = c_.wxyz;\n"
+"\n"
+"    vec4 i4_  = vec4(dot(v2f,i4[0]),dot(v2f,i4[1]),dot(v2f,i4[2]),dot(v2f,i4[3]));\n"
+"    vec4 i5_  = vec4(dot(v2f,i5[0]),dot(v2f,i5[1]),dot(v2f,i5[2]),dot(v2f,i5[3]));\n"
+"    vec4 h5_  = vec4(dot(v2f,h5[0]),dot(v2f,h5[1]),dot(v2f,h5[2]),dot(v2f,h5[3]));\n"
+"    vec4 f4_  = h5_.yzwx;\n"
+"\n"
+"    // These inequations define the line below which interpolation occurs.\n"
+"    fx    = ( Ao*fp.y + Bo*fp.x );\n"
+"    fx_l  = ( Ax*fp.y + Bx*fp.x );\n"
+"    fx_u  = ( Ay*fp.y + By*fp.x );\n"
+"\n"
+"    irlv0 = xbr_diff(e_,f_) * xbr_diff(e_,h_);\n"
+"    irlv1 = irlv0;\n"
+"\n"
+"#ifdef CORNER_B\n"
+"    irlv1      = xbr_clamp01(irlv0 * ( xbr_neq(f,b) * xbr_neq(h,d) + xbr_eq(e,i) * xbr_neq(f,i4) * xbr_neq(h,i5) + xbr_eq(e,g) + xbr_eq(e,c) ) );\n"
+"#endif\n"
+"#ifdef CORNER_C\n"
+"    irlv1     = xbr_clamp01(irlv0  * ( xbr_neq(f,b) * xbr_neq(f,c) + xbr_neq(h,d) * xbr_neq(h,g) + xbr_eq(e,i) * (xbr_neq(f,f4) * xbr_neq(f,i4) + xbr_neq(h,h5) * xbr_neq(h,i5)) + xbr_eq(e,g) + xbr_eq(e,c)) );\n"
+"#endif\n"
+"\n"
+"    irlv2l = xbr_diff(e_,g_) * xbr_diff( d_, g_);\n"
+"    irlv2u = xbr_diff(e_,c_) * xbr_diff( b_, c_);\n"
+"\n"
+"    if (1.0 == 1.0) {\n"
+"        vec4 delta  = vec4(aa_factor);\n"
+"        vec4 deltaL = vec4(0.5, 1.0, 0.5, 1.0) * aa_factor;\n"
+"        vec4 deltaU = deltaL.yxwz;\n"
+"\n"
+"        fx45i = xbr_clamp01( 0.5 + (fx   - Co - Ci) / delta  );\n"
+"        fx45  = xbr_clamp01( 0.5 + (fx   - Co     ) / delta  );\n"
+"        fx30  = xbr_clamp01( 0.5 + (fx_l - Cx     ) / deltaL );\n"
+"        fx60  = xbr_clamp01( 0.5 + (fx_u - Cy     ) / deltaU );\n"
+"    }\n"
+"    else {\n"
+"        fx45i = xbr_LT( Co + Ci, fx   );\n"
+"        fx45  = xbr_LT(      Co, fx   );\n"
+"        fx30  = xbr_LT(      Cx, fx_l );\n"
+"        fx60  = xbr_LT(      Cy, fx_u );\n"
+"    }\n"
+"\n"
+"    vec4 wd1 = xbr_weighted_distance( e, c,  g, i, h5, f4, h, f);\n"
+"    vec4 wd2 = xbr_weighted_distance( h, d, i5, f, i4,  b, e, i);\n"
+"\n"
+"    vec4 d_fg = xbr_dist4(f, g);\n"
+"    vec4 d_hc = xbr_dist4(h, c);\n"
+"\n"
+"    edri      = xbr_LTE(wd1, wd2) * irlv0;\n"
+"    edr       = xbr_LT( wd1, wd2) * irlv1 * xbr_NOT(edri.yzwx * edri.wxyz);\n"
+"    edr_l     = xbr_LTE( 2.3 * d_fg, d_hc ) * irlv2l * edr * (xbr_NOT(edri.yzwx) * xbr_eq(e, c));\n"
+"    edr_u     = xbr_LTE( 2.3 * d_hc, d_fg ) * irlv2u * edr * (xbr_NOT(edri.wxyz) * xbr_eq(e, g));\n"
+"\n"
+"    fx45i = edri   * fx45i;\n"
+"    fx45  = edr    * fx45;\n"
+"    fx30  = edr_l  * fx30;\n"
+"    fx60  = edr_u  * fx60;\n"
+"\n"
+"    px = xbr_LTE(xbr_dist4(e,f), xbr_dist4(e,h));\n"
+"\n"
+"    vec4 maximos = max(max(fx30, fx60), max(fx45, fx45i));\n"
+"\n"
+"    res1 = mix(E, mix(H, F, px.x), maximos.x);\n"
+"    res2 = mix(E, mix(B, D, px.z), maximos.z);\n"
+"\n"
+"    vec3 res1a = mix(res1, res2, step(xbr_dist(E, res1), xbr_dist(E, res2)));\n"
+"\n"
+"    res1 = mix(E, mix(F, B, px.y), maximos.y);\n"
+"    res2 = mix(E, mix(D, H, px.w), maximos.w);\n"
+"\n"
+"    vec3 res1b = mix(res1, res2, step(xbr_dist(E, res1), xbr_dist(E, res2)));\n"
+"\n"
+"    vec3 res = mix(res1a, res1b, step(xbr_dist(E, res1a), xbr_dist(E, res1b)));\n"
+"\n"
+"\n"
+"return vec4(res,1.0);\n"
+"}\n"
+"\n"
+"layout(push_constant, std430) uniform PushConstants { vec4 options; };\n"
+"vec3 vetaLinear(vec2 uv){\n"
+" ivec2 size=textureSize(guest_output,0);vec2 p=uv*vec2(size)-0.5;ivec2 base=ivec2(floor(p));vec2 f=fract(p);\n"
+" vec3 a=texelFetch(guest_output,clamp(base,ivec2(0),size-1),0).rgb;\n"
+" vec3 b=texelFetch(guest_output,clamp(base+ivec2(1,0),ivec2(0),size-1),0).rgb;\n"
+" vec3 c=texelFetch(guest_output,clamp(base+ivec2(0,1),ivec2(0),size-1),0).rgb;\n"
+" vec3 d=texelFetch(guest_output,clamp(base+ivec2(1),ivec2(0),size-1),0).rgb;\n"
+" return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);\n"
+"}\n"
+"void main(){\n"
+" if(options.z<0.5){veta_fsr_main();return;}\n"
+" if(options.z<1.5){\n"
+"  vec2 size=vec2(textureSize(guest_output,0)),outputSize=round(1.0/max(fwidth(tex_coord),vec2(0.000001)));\n"
+"  out_color=any(lessThan(outputSize,size))?vec4(vetaLinear(tex_coord),1.0):xbr_scale(guest_output,tex_coord,false);return;\n"
+" }\n"
+" if(options.z<2.5){out_color=vec4(vetaLinear(tex_coord),1.0);return;}\n"
+" ivec2 size=textureSize(guest_output,0);out_color=vec4(texelFetch(guest_output,clamp(ivec2(floor(tex_coord*vec2(size))),ivec2(0),size-1),0).rgb,1.0);\n"
+"}\n"
