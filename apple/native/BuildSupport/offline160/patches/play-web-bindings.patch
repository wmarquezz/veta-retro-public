+// VM operations are queued to the emulation thread. The browser polls futures
+// without blocking, so WebGL/audio/disc proxies can keep servicing VM requests.
+static bool operationAvailable()
+{
+    return g_virtualMachine && g_operations.size() < 8;
+}
+
+static uint32 trackOperation(std::future<bool> future)
+{
+    do { ++g_nextOperation; } while(!g_nextOperation || g_operations.count(g_nextOperation));
+    g_operations.emplace(g_nextOperation, std::move(future));
+    return g_nextOperation;
+}
+
+static bool validStatePath(const std::string& path)
+{
+    return path.size() > 6 && path.size() < 256 && path.compare(0, 6, "/work/") == 0
+        && path.find("..") == std::string::npos && path.find('\\') == std::string::npos
+        && path.find('\0') == std::string::npos;
+}
+
+uint32 saveState(std::string path)
+{
+    if(!operationAvailable() || !validStatePath(path)) return 0;
+    return trackOperation(g_virtualMachine->SaveState(path));
+}
+
+uint32 loadState(std::string path)
+{
+    if(!operationAvailable() || !validStatePath(path)) return 0;
+    return trackOperation(g_virtualMachine->LoadState(path));
+}
+
+uint32 setPaused(bool paused)
+{
+    if(!operationAvailable()) return 0;
+    if(paused && g_vetaPad) g_vetaPad->ResetAll();
+    return trackOperation(g_virtualMachine->SetPausedAsync(paused));
+}
+
+// 0 pending, 1 successful, -1 failed, -2 unknown. Completion consumes the ID.
+int pollOperation(uint32 id)
+{
+    auto found = g_operations.find(id);
+    if(found == g_operations.end()) return -2;
+    if(found->second.wait_for(std::chrono::seconds(0)) != std::future_status::ready) return 0;
+    bool result = false;
+    try { result = found->second.get(); } catch(...) {}
+    g_operations.erase(found);
+    return result ? 1 : -1;
+}
+
+bool setInputButton(uint32 port, uint32 button, bool pressed)
+{
+    return g_vetaPad && g_vetaPad->SetButton(port, button, pressed);
+}
+
+bool setInputAxis(uint32 port, uint32 axis, int value)
+{
+    return g_vetaPad && g_vetaPad->SetAxis(port, axis, value);
+}
+
+void resetInput()
+{
+    if(g_vetaPad) g_vetaPad->ResetAll();
+}
+
+// Preferences are fixed before initVm; recreate the WebView to change quality.
+bool setResolutionFactor(int factor)
+{
+    if(g_virtualMachine || factor < 1 || factor > 4) return false;
+    CGSH_OpenGL::RegisterPreferences();
+    return CAppConfig::GetInstance().SetPreferenceInteger(PREF_CGSH_OPENGL_RESOLUTION_FACTOR, factor);
+}
+
+std::string getDataPath()
+{
+    return CAppConfig::GetInstance().GetBasePath().string();
+}
+
+std::string getStateFormat()
+{
+    return "play-505dac7-vmzip-timing-v1";
+}
