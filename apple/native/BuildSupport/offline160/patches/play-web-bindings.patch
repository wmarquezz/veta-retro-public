diff --git a/Source/ui_js/VetaWebInput.h b/Source/ui_js/VetaWebInput.h
new file mode 100644
--- /dev/null
+++ b/Source/ui_js/VetaWebInput.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include "input/PH_GenericInput.h"
+#include <algorithm>
+#include <array>
+#include <atomic>
+
+// Native overlay input is stored atomically; only the VM thread calls pad
+// interfaces. Existing keyboard bindings remain available before native input.
+class CVetaWebInput : public CPH_GenericInput
+{
+public:
+    static constexpr uint32 PORTS = CInputBindingManager::MAX_PADS;
+    static constexpr uint32 BUTTONS = PS2::CControllerInfo::MAX_BUTTONS;
+
+    CVetaWebInput()
+    {
+        for(auto& enabled : m_enabled) enabled.store(false);
+        ResetAll();
+    }
+
+    bool SetButton(uint32 port, uint32 button, bool pressed)
+    {
+        if(port >= PORTS || button < 4 || button >= BUTTONS) return false;
+        m_values[port][button].store(pressed ? 1 : 0, std::memory_order_relaxed);
+        m_enabled[port].store(true, std::memory_order_release);
+        return true;
+    }
+
+    bool SetAxis(uint32 port, uint32 axis, int value)
+    {
+        if(port >= PORTS || axis >= 4) return false;
+        value = std::clamp(value, -32768, 32767);
+        const uint32 converted = value < 0 ? 127 + value * 127 / 32768 : 127 + value * 128 / 32767;
+        m_values[port][axis].store(converted, std::memory_order_relaxed);
+        m_enabled[port].store(true, std::memory_order_release);
+        return true;
+    }
+
+    void ResetAll()
+    {
+        for(auto& port : m_values)
+            for(uint32 button = 0; button < BUTTONS; ++button)
+                port[button].store(button < 4 ? 127 : 0, std::memory_order_relaxed);
+    }
+
+    void Update(uint8* ram) override
+    {
+        CPH_GenericInput::Update(ram);
+        for(auto* interface : m_interfaces)
+            for(uint32 port = 0; port < PORTS; ++port)
+                if(m_enabled[port].load(std::memory_order_acquire))
+                    for(uint32 index = 0; index < BUTTONS; ++index)
+                    {
+                        const auto button = static_cast<PS2::CControllerInfo::BUTTON>(index);
+                        const auto value = m_values[port][index].load(std::memory_order_relaxed);
+                        if(index < 4) interface->SetAxisState(port, button, static_cast<uint8>(value), ram);
+                        else interface->SetButtonState(port, button, value != 0, ram);
+                    }
+    }
+
+private:
+    std::array<std::array<std::atomic<uint32>, BUTTONS>, PORTS> m_values;
+    std::array<std::atomic<bool>, PORTS> m_enabled;
+};
