 static CPS2VM* m_virtualMachine = nullptr;
 static bool first_run = false;
+
+// EE/IOP run on their own thread, while libretro owns the GS thread.
+// Drain GS work while requesting a pause so the VM cannot deadlock waiting
+// for its frame queue. State files must never race live guest RAM/registers.
+class ScopedVMPause
+{
+public:
+    explicit ScopedVMPause(CPS2VM* vm) : m_vm(vm), m_resume(vm->GetStatus() == CVirtualMachine::RUNNING)
+    {
+        if(m_resume)
+        {
+            m_vm->PauseAsync();
+            while(m_vm->GetStatus() != CVirtualMachine::PAUSED)
+            {
+                FlushGraphics();
+                std::this_thread::yield();
+            }
+        }
+        FlushGraphics();
+    }
+    ~ScopedVMPause()
+    {
+        FlushGraphics();
+        if(m_resume) m_vm->Resume();
+    }
+    void FlushGraphics()
+    {
+        if(auto gs = static_cast<CGSH_OpenGL_Libretro*>(m_vm->GetGSHandler()))
+            gs->FlushMailBox();
+    }
+private:
+    CPS2VM* m_vm;
+    bool m_resume;
+};
 
